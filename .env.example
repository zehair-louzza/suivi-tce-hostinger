# ==============================================================================
# ANELEC SUIVI TCE — Variables d'Environnement (Modèle)
# Copier ce fichier en `.env` pour le développement local ou configurer dans Hostinger hPanel.
# NE JAMAIS COMMITTER DE VRAIS SECRETS DANS GIT.
# ==============================================================================

# --- Base de données PostgreSQL / Supabase (Session Pooler TLS recommandé) ---
DATABASE_URL="postgresql://postgres.[PROJECT_REF]:[PASSWORD]@aws-0-eu-west-3.pooler.supabase.com:5432/postgres?sslmode=require"

# --- Serveur & URLs publiques ---
NODE_ENV="development"
PORT="3001"
APP_URL="https://suivi.anelecgroupe.com"
CORS_ORIGIN="http://localhost:5173"
SOCKET_CORS_ORIGIN="http://localhost:5173"

# --- Sécurité, JWT, Cookies & Chiffrement SMTP par société ---
# En production, fournir une clé aléatoire >= 64 caractères
JWT_SECRET="remplacer-par-une-cle-secrete-aleatoire-de-64-caracteres-minimum"
JWT_EXPIRES_IN="7d"
JWT_REFRESH_EXPIRES_IN="30d"
COOKIE_SECRET="remplacer-par-une-cle-cookie-secrete-aleatoire"
MAIL_SECRET_KEY="remplacer-par-une-cle-aes-pour-chiffrement-smtp-tenant"

# --- Limitation de débit API (optionnel) ---
RATE_LIMIT_WINDOW_MS="900000"
RATE_LIMIT_MAX="3000"

# --- Authentification Google OAuth 2.0 (optionnel) ---
GOOGLE_CLIENT_ID=""

# --- Messagerie SMTP globale & secours Supabase (optionnel) ---
SMTP_HOST=""
SMTP_PORT="465"
SMTP_USER=""
SMTP_PASS=""
SUPABASE_URL=""
SUPABASE_ANON_KEY=""
