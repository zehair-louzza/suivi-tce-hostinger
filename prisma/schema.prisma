// Prisma Schema - SQLite for Hostinger deployment
// Remarque : SQLite ne gère pas les enum ni les types natifs (@db.*) avec Prisma 5 ;
// rôles et statuts sont donc des String, validés par Zod côté serveur.
generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model User {
  id        Int      @id @default(autoincrement())
  email     String   @unique
  password  String
  name      String
  role      String   @default("USER") // ADMIN | USER | VIEWER
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  devis         Devis[]
  interventions Intervention[]

  @@map("users")
}


model Devis {
  id          Int      @id @default(autoincrement())
  client      String
  amount      Float    @default(0)
  dateCreated DateTime
  echeance    DateTime?
  status      String   @default("A_TRAITER") // A_TRAITER | EN_COURS | EN_ATTENTE | BLOQUE | TRAITE
  notes       String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  userId      Int
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  interventions Intervention[]

  @@index([userId])
  @@index([status])
  @@index([dateCreated])
  @@map("devis")
}

model Intervention {
  id                 Int      @id @default(autoincrement())
  chantier           String
  entreprise         String?
  amount             Float    @default(0)
  datePlanifiee      DateTime
  dateReelle         DateTime?
  status             String   @default("A_TRAITER") // A_TRAITER | EN_COURS | EN_ATTENTE | BLOQUE | TRAITE
  notes              String?

  // Traçabilité conversion devis -> intervention
  origineDevisId     Int?
  origineDevisClient String?
  origineDevisDate   DateTime?

  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  userId             Int
  user               User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  devisId            Int?
  devis              Devis?   @relation(fields: [devisId], references: [id], onDelete: SetNull)

  @@index([userId])
  @@index([status])
  @@index([datePlanifiee])
  @@index([devisId])
  @@map("interventions")
}
