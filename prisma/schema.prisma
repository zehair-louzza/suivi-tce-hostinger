generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Company {
  id                   Int                  @id @default(autoincrement())
  name                 String
  siret                String?
  siren                String?
  active               Boolean              @default(true)
  /// Adresse du siège / point de départ des tournées
  siegeAdresse         String?
  siegeLat             Float?
  siegeLng             Float?
  defaultTheme         String               @default("light")
  allowThemeOverride   Boolean              @default(true)
  /// Ouvrir le tableau de bord sur « Ma file » plutôt que sur la synthèse
  accueilMaFile        Boolean              @default(false)
  /// Automatisations « technicien » : acceptation de mission, relance, alerte au planificateur
  autoTechnicienActif        Boolean        @default(true)
  /// Délai avant relance d'un technicien qui n'a pas répondu (minutes)
  autoTechnicienDelaiMinutes Int            @default(120)
  createdAt            DateTime             @default(now())
  updatedAt            DateTime             @updatedAt
  users                User[]
  devis                Devis[]
  interventions        Intervention[]
  pointagesTechniciens PointageTechnicien[]
  referentiels         Referentiel[]
  invitations          CompanyInvitation[]
  demandes             Demande[]
  mailSettings         CompanyMailSettings?
  emailLogs            EmailLog[]
  notifications        Notification[]

  @@map("companies")
}

model User {
  id                 Int                 @id @default(autoincrement())
  email              String              @unique
  password           String
  name               String
  role               String              @default("USER")
  technicienNom      String?
  permissionsJson    String?
  active             Boolean             @default(true)
  emailConfirmed     Boolean             @default(false)
  confirmationToken  String?
  confirmationCode   String?
  confirmationCodeExpires DateTime?
  confirmationSentAt DateTime?
  termsAcceptedAt    DateTime?
  termsAcceptedIp    String?
  themePref          String?
  companyId          Int?
  company            Company?            @relation(fields: [companyId], references: [id], onDelete: SetNull)
  createdAt          DateTime            @default(now())
  updatedAt          DateTime            @updatedAt
  devis              Devis[]
  interventions      Intervention[]
  conversionRequests ConversionRequest[]
  pointages          PointageTechnicien[]
  notifications      Notification[]
  invitationsSent    CompanyInvitation[] @relation("InvitationsSent")

  demandes             Demande[]

  @@index([companyId], map: "users_companyid_idx")
  @@map("users")
}

model Devis {
  id                   Int            @id @default(autoincrement())
  client               String
  amount               Float          @default(0)
  /// Taux de TVA choisi à la saisie ; NULL = présélection selon le type de client
  tauxTVA              Float?
  dateCreated          DateTime
  echeance             DateTime?
  status               String         @default("A_TRAITER")
  notes                String?
  createdAt            DateTime       @default(now())
  updatedAt            DateTime       @updatedAt
  userId               Int
  user                 User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  companyId            Int?
  company              Company?       @relation(fields: [companyId], references: [id], onDelete: Cascade)
  interventions        Intervention[]
  demandes             Demande[]
  referenceMetier      String?
  numeroDI             String?
  siteAdresse          String?
  objet                String?
  corpsEtat            String?
  origine              String?
  dateDemande          DateTime?      @db.Date
  traitement           String?
  priorite             String?
  statutCommercial     String?
  dateLimite           DateTime?      @db.Date
  dateEnvoi            DateTime?      @db.Date
  montantHt            Decimal?       @db.Decimal(14, 2)
  validiteJours        Int?
  prochaineAction      String?
  dateRelance          DateTime?      @db.Date
  responsable          String?
  commentaires         String?
  version              Int            @default(0)

  // Champs additionnels Planning Visite Devis & Historique ANELEC
  refInterventionTexte String?
  visiteNecessaire     Boolean        @default(false)
  visiteTechnicien     String?
  visiteDate           DateTime?      @db.Date
  visiteHeureDebut     String?
  visiteHeureFin       String?
  visiteStatut         String?
  visitePhotosJson     String?
  historiqueJson       String?

  @@index([userId])
  @@index([companyId], map: "devis_companyid_idx")
  @@index([companyId, numeroDI], map: "devis_companyid_numerodi_idx")
  @@index([status])
  @@index([dateCreated])
  @@index([userId, traitement], map: "devis_userid_traitement_idx")
  @@index([userId, statutCommercial], map: "devis_userid_statutcommercial_idx")
  @@index([userId, dateRelance], map: "devis_userid_daterelance_idx")
  @@map("devis")
}

/// Demande reçue du donneur d'ordre, avant qu'elle devienne devis ou intervention.
/// La clé de suivi est le couple (client + numeroDI) : le DI est émis par le client,
/// donc deux donneurs d'ordre peuvent porter le même numéro. Les particuliers n'ont
/// pas de DI et sont suivis par une référence interne.
model Demande {
  id                Int           @id @default(autoincrement())
  typeDemandeur     String        @default("DONNEUR_ORDRE")
  client            String
  numeroDI          String?
  referenceInterne  String?
  site              String?
  objet             String?
  corpsEtat         String?
  priorite          String        @default("Normale")
  canalReception    String?
  dateReception     DateTime      @db.Date
  echeanceSouhaitee DateTime?     @db.Date
  notes             String?
  statut            String        @default("A_DECIDER")
  decision          String?
  decidedAt         DateTime?
  devisId           Int?
  devis             Devis?        @relation(fields: [devisId], references: [id], onDelete: SetNull)
  interventionId    Int?
  intervention      Intervention? @relation(fields: [interventionId], references: [id], onDelete: SetNull)
  historiqueJson    String?
  userId            Int
  user              User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  companyId         Int?
  company           Company?      @relation(fields: [companyId], references: [id], onDelete: Cascade)
  createdAt         DateTime      @default(now())
  updatedAt         DateTime      @updatedAt

  @@index([companyId, statut, dateReception], map: "demandes_companyid_statut_date_idx")
  @@index([companyId, client, numeroDI], map: "demandes_companyid_client_di_idx")
  @@index([userId], map: "demandes_userid_idx")
  @@index([devisId], map: "demandes_devisid_idx")
  @@index([interventionId], map: "demandes_interventionid_idx")
  @@map("demandes")
}

model Intervention {
  id                 Int                 @id @default(autoincrement())
  chantier           String
  entreprise         String?
  amount             Float               @default(0)
  /// Taux de TVA choisi à la saisie ; NULL = présélection selon le type de client
  tauxTVA              Float?
  datePlanifiee      DateTime
  dateReelle         DateTime?
  status             String              @default("A_TRAITER")
  notes              String?
  origineDevisId     Int?
  origineDevisClient String?
  origineDevisDate   DateTime?
  createdAt          DateTime            @default(now())
  updatedAt          DateTime            @updatedAt
  userId             Int
  user               User                @relation(fields: [userId], references: [id], onDelete: Cascade)
  companyId          Int?
  company            Company?            @relation(fields: [companyId], references: [id], onDelete: Cascade)
  devisId            Int?
  devis              Devis?              @relation(fields: [devisId], references: [id], onDelete: SetNull)
  referenceMetier    String?
  numeroDI           String?
  client             String?
  siteAdresse        String?
  objet              String?
  corpsEtat          String?
  origine            String?
  dateDemande        DateTime?           @db.Date
  traitement         String?
  priorite           String?
  statutOperationnel String?
  typeIntervention   String?
  technicien         String?
  dateDebut          DateTime?           @db.Date
  dateFin            DateTime?           @db.Date
  dateEcheance       DateTime?           @db.Date
  resultatTechnique  String?
  motifBlocage       String?
  numeroFacture      String?
  statutFacture      String?
  compteRendu        String?
  version            Int                 @default(0)
  conversionRequests ConversionRequest[]

  // Champs additionnels Planning Horaire (Souris + Clavier) & Historique ANELEC
  refDevisTexte      String?
  modePlanification  String?
  heureDebut         String?
  heureFin           String?
  isVisiteDevis      Boolean             @default(false)
  historiqueJson     String?

  // Champs Mobile Technicien, Chiffrage & Rédaction Rapports
  heureDebutReelle     String?
  heureFinReelle       String?
  actionsRealiseesJson String?
  photosJson           String?
  elementsChiffrage    String?
  rapportFinal         String?
  statutRapport        String?

  // Réponse du technicien à son affectation (EN_ATTENTE | ACCEPTEE | REFUSEE ; NULL = non concerné)
  reponseTechnicien    String?
  reponseLe            DateTime?
  motifRefus           String?
  affecteLe            DateTime?
  relanceTechnicienLe  DateTime?
  alertePlanificateurLe DateTime?

  demandes           Demande[]

  @@index([userId])
  @@index([companyId, reponseTechnicien], map: "interventions_companyid_reponse_idx")
  @@index([companyId], map: "interventions_companyid_idx")
  @@index([companyId, numeroDI], map: "interventions_companyid_numerodi_idx")
  @@index([status])
  @@index([datePlanifiee])
  @@index([devisId])
  @@index([userId, traitement], map: "interventions_userid_traitement_idx")
  @@index([userId, statutOperationnel], map: "interventions_userid_statutoperationnel_idx")
  @@index([userId, dateEcheance], map: "interventions_userid_dateecheance_idx")
  @@map("interventions")
}

model ConversionRequest {
  id             Int          @id @default(autoincrement())
  actorId        Int
  actor          User         @relation(fields: [actorId], references: [id], onDelete: Restrict)
  key            String       @db.VarChar(128)
  requestHash    String       @db.VarChar(64)
  interventionId Int
  intervention   Intervention @relation(fields: [interventionId], references: [id], onDelete: Restrict)
  response       Json
  createdAt      DateTime     @default(now())

  @@unique([actorId, key], map: "conversion_requests_actorid_key_key")
  @@index([interventionId], map: "conversion_requests_interventionid_idx")
  @@map("conversion_requests")
}

model Referentiel {
  id        Int      @id @default(autoincrement())
  categorie String
  valeurs   String
  companyId Int?
  company   Company? @relation(fields: [companyId], references: [id], onDelete: Cascade)
  updatedAt DateTime @updatedAt

  @@unique([categorie, companyId], map: "referentiels_categorie_companyid_key")
  @@map("referentiels")
}

model PointageTechnicien {
  id                      Int       @id @default(autoincrement())
  technicien              String
  userId                  Int?
  user                    User?     @relation(fields: [userId], references: [id], onDelete: SetNull)
  companyId               Int?
  company                 Company?  @relation(fields: [companyId], references: [id], onDelete: Cascade)
  dateJour                String
  heureArriveeBureau      String?
  timestampArrivee        DateTime?
  heureFinJournee         String?
  timestampFin            DateTime?
  statutJournee           String    @default("EN_SERVICE")
  derniereInterventionRef String?
  commentaireJournee      String?
  createdAt               DateTime  @default(now())
  updatedAt               DateTime  @updatedAt

  @@unique([technicien, dateJour, companyId], map: "pointages_techniciens_technicien_datejour_company_key")
  @@index([companyId], map: "pointages_techniciens_companyid_idx")
  @@index([userId], map: "pointages_techniciens_userid_idx")
  @@map("pointages_techniciens")
}

// Invitation e-mail pour rejoindre une entreprise (jeton à usage unique, stocké haché)
model CompanyInvitation {
  id            Int       @id @default(autoincrement())
  companyId     Int
  company       Company   @relation(fields: [companyId], references: [id], onDelete: Cascade)
  email         String
  role          String    @default("CONDUCTEUR_TRAVAUX")
  technicienNom String?
  permissionsJson String?
  tokenHash     String    @unique
  invitedById   Int?
  invitedBy     User?     @relation("InvitationsSent", fields: [invitedById], references: [id], onDelete: SetNull)
  invitedByName String?
  expiresAt     DateTime
  lastSentAt    DateTime?
  acceptedAt    DateTime?
  revokedAt     DateTime?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  @@index([companyId], map: "company_invitations_companyid_idx")
  @@index([invitedById], map: "company_invitations_invitedbyid_idx")
  @@map("company_invitations")
}

// Boîte d'envoi propre à chaque entreprise (SMTP). Le mot de passe est chiffré (AES-256-GCM).
model CompanyMailSettings {
  companyId   Int       @id
  company     Company   @relation(fields: [companyId], references: [id], onDelete: Cascade)
  smtpHost    String
  smtpPort    Int       @default(465)
  smtpSecure  Boolean   @default(true)
  smtpUser    String
  smtpPassEnc String?
  fromName    String?
  replyTo     String?
  enabled     Boolean   @default(true)
  lastTestAt  DateTime?
  lastTestOk  Boolean?
  lastError   String?
  updatedAt   DateTime  @updatedAt

  @@map("company_mail_settings")
}

// Journal d'envoi des e-mails, cloisonné par entreprise
model EmailLog {
  id        Int      @id @default(autoincrement())
  companyId Int?
  company   Company? @relation(fields: [companyId], references: [id], onDelete: Cascade)
  type      String
  toEmail   String
  ccEmail   String?
  subject   String
  channel   String
  sent      Boolean
  error     String?
  createdAt DateTime @default(now())

  @@index([companyId, createdAt], map: "email_logs_companyid_createdat_idx")
  @@map("email_logs")
}

/// Notifications dans l'application : une ligne par destinataire, toujours rattachée à sa société.
model Notification {
  id             Int      @id @default(autoincrement())
  companyId      Int
  company        Company  @relation(fields: [companyId], references: [id], onDelete: Cascade)
  userId         Int
  user           User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  type           String
  titre          String
  message        String?
  interventionId Int?
  lu             Boolean  @default(false)
  createdAt      DateTime @default(now())

  @@index([userId, lu, createdAt], map: "notifications_user_lu_idx")
  @@index([companyId], map: "notifications_companyid_idx")
  @@map("notifications")
}
